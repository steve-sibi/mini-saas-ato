{
  "name": "ATO-001 Password Spray",
  "type": "log alert",
  "query": "logs(\"service:ato-sentinel @event_type:login @outcome:fail @risk_flags:password_spray_suspected\").index(\"main\").rollup(\"count\").by(\"@source_ip\").last(\"10m\") >= 1",
  "message": "Password spray suspected against multiple accounts. Route to webhook containment for IP challenge mode.",
  "tags": [
    "service:ato-sentinel",
    "usecase:ato",
    "mitre:T1110.003"
  ],
  "options": {
    "thresholds": {
      "critical": 1
    },
    "include_tags": true,
    "evaluation_delay": 60
  }
}
