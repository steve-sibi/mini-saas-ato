{
  "name": "ATO-002 Session Reuse",
  "type": "log alert",
  "query": "logs(\"service:ato-sentinel @event_type:session_access @risk_flags:session_reuse_suspected\").index(\"main\").rollup(\"count\").by(\"@session_id\").last(\"15m\") >= 1",
  "message": "Session cookie reuse suspected. Route to webhook containment for session revoke.",
  "tags": [
    "service:ato-sentinel",
    "usecase:ato",
    "mitre:T1550.004"
  ],
  "options": {
    "thresholds": {
      "critical": 1
    },
    "include_tags": true,
    "evaluation_delay": 60
  }
}
