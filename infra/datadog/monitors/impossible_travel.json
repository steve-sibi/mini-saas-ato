{
  "name": "ATO-003 Impossible Travel",
  "type": "log alert",
  "query": "logs(\"service:ato-sentinel @event_type:login @outcome:success @risk_flags:impossible_travel_suspected\").index(\"main\").rollup(\"count\").by(\"@email\").last(\"6h\") >= 1",
  "message": "Impossible travel suspected for a valid account. Route to webhook containment for account step-up.",
  "tags": [
    "service:ato-sentinel",
    "usecase:ato",
    "mitre:T1078.004"
  ],
  "options": {
    "thresholds": {
      "critical": 1
    },
    "include_tags": true,
    "evaluation_delay": 60
  }
}
